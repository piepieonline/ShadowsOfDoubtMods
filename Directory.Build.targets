<Project>
    <!-- Deploy the built plugin into the BepInEx profile and zip it for distribution.
         Built-in MSBuild tasks cover every OS, so there is no copy/xcopy vs cp/rsync/7z
         split and nothing extra has to be on PATH. Skipped when BepInEx is not installed
         at the configured path, so a build still succeeds on a machine without it. -->
    <Target Name="DeployToBepInEx" AfterTargets="PostBuildEvent"
            Condition="'$(BepInExPath)'!='' And Exists('$(BepInExPath)')">
        <PropertyGroup>
            <PluginDeployPath>$(BepInExPath)plugins/$(ProjectName)</PluginDeployPath>
        </PropertyGroup>

        <ItemGroup>
            <DeployBinary Include="$(TargetDir)$(TargetName).dll" Condition="'$(IsContentOnlyMod)'!='true'" />
            <DeployBinary Include="$(TargetDir)$(TargetName).pdb" Condition="'$(IsContentOnlyMod)'!='true' And Exists('$(TargetDir)$(TargetName).pdb')" />
            <DeployContent Include="$(ProjectDir)ModFolderContent/**/*" />
        </ItemGroup>

        <MakeDir Directories="$(PluginDeployPath)" />
        <Copy SourceFiles="@(DeployBinary)" DestinationFolder="$(PluginDeployPath)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(DeployContent)"
              DestinationFiles="@(DeployContent->'$(PluginDeployPath)/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />

        <ZipDirectory SourceDirectory="$(PluginDeployPath)"
                      DestinationFile="$(BepInExPath)plugins/$(ProjectName).zip"
                      Overwrite="true" />
    </Target>
</Project>
